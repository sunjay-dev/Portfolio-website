<!DOCTYPE html>
<html lang="en">

<head>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&display=swap" rel="stylesheet">
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Portfolio Website</title>
  <link href="/css/style.css" rel="stylesheet" />
</head>

<body class="font-[Inter] relative overflow-x-hidden selection:bg-[#3d3d3d] selection:text-gray-50">
  <button class="fixed bottom-6 right-6 z-50 bg-[#3d3d3d] rounded-full p-3 select-none">
    <img class="h-5 w-5" src="/svg/night.svg">
  </button>
  <div class="w-dvw h-dvh p-2 relative bg-[url(/img/homeBg.jpeg)] bg-cover bg-center">

    <div class="absolute inset-0 bg-white opacity-95 z-0"></div>

    <div class="relative z-10 sm:px-6 px-4 py-4 h-full flex flex-col justify-start">
      <header class="flex justify-between items-center mb-8">
        <div class="flex items-center space-x-2">
          <img src="/svg/code.svg" class="h-8 w-8 select-none">
          <h1 class="font-bold opacity-80 text-xl">Sunjay Kumar</h1>
        </div>

        <div class="[&>*]:cursor-pointer [&>*]:hover:text-gray-700 items-center space-x-8 pr-4 font-medium text-gray-600 hidden md:flex">
          <a>Home</a>
          <a >About</a>
          <a>Skills</a>
          <a>Achievements</a>
          <a>Education</a>
          <a>Contact</a>
        </div>
        <div class="md:hidden">
          <img src="/svg/hamburger.svg" class="h-6 w-6">
        </div>
      </header>

      <div class="text-center sm:mt-9 mt-24">
        <h2 class="md:text-[4.6rem] sm:text-6xl text-5xl leading-[1.10] font-bold text-[#3d3d3d]">Sunjay Kumar</h2>
        <p class="md:text-5xl sm:text-4xl text-3xl mt-1 font-bold text-[#6a6a6a]">Node.js Backend Developer</p>
        <p class="md:text-2xl sm:text-xl text-lg text-[#6a6a6a] mt-6">Building robust, scalable, and efficient backend
          solutions</p>
      </div>
      <div class="mt-[3.75rem] space-x-4 flex justify-center">
        <button class="max-w-3xl py-3 px-6 box-border bg-[#3d3d3d] text-white border rounded-md hover:opacity-90">Get in Touch</button>
        <button class="max-w-3xl py-3 px-6 box-border border-[#3d3d3d] border-2 rounded-md hover:bg-[#3d3d3d] hover:text-gray-50 transition duration-300">Learn More</button>
      </div>

      <div class="flex justify-center space-x-6 mt-14 items-center select-none">
        <img src="/svg/github.svg" class="w-6 h-6 opacity-60 hover:opacity-40 cursor-pointer">
        <img src="/svg/linkedin.svg" class="w-6 h-6 opacity-60 hover:opacity-40 cursor-pointer">
        <img src="/svg/resume.svg" class="w-6 h-6 opacity-60 hover:opacity-40 cursor-pointer">
      </div>
      <div class="flex justify-center items-center mt-8 select-none">
        <img src="/svg/arrow.svg" class="w-8 h-8 animate-bounce opacity-60 cursor-pointer hover:opacity-40">
      </div>
    </div>
  </div>
  <%- include('partials/temp') %>
</body>

</html>